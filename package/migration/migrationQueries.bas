'----------------------------------------------------------------------
' sparepart_find_by_name.sql
' Query   : sparepart_find_by_name
' Type    : SELECT
' Purpose : Resolve a name used by a plant to the catalogue sparepart:
'           matches the catalogue code, name or alias.
'           No row = the name is not in the catalogue.
'           matched_on: CATALOGUE (code or name) or ALIAS.
'----------------------------------------------------------------------
Public Sub Query_sparepart_find_by_name()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_name] Text(255);" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    s.id AS id," & vbCrLf
    sql = sql & "    s.code AS code," & vbCrLf
    sql = sql & "    s.[name] AS [name]," & vbCrLf
    sql = sql & "    s.alias AS alias," & vbCrLf
    sql = sql & "    s.unit_of_measurement AS unit_of_measurement," & vbCrLf
    sql = sql & "    IIf(" & vbCrLf
    sql = sql & "        s.[name] = [p_name]" & vbCrLf
    sql = sql & "        OR s.code = [p_name]," & vbCrLf
    sql = sql & "        'CATALOGUE'," & vbCrLf
    sql = sql & "        'ALIAS'" & vbCrLf
    sql = sql & "    ) AS matched_on" & vbCrLf
    sql = sql & "FROM" & vbCrLf
    sql = sql & "    spareparts AS s" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    (" & vbCrLf
    sql = sql & "        s.[name] = [p_name]" & vbCrLf
    sql = sql & "        OR s.code = [p_name]" & vbCrLf
    sql = sql & "        OR s.alias = [p_name]" & vbCrLf
    sql = sql & "    )" & vbCrLf
    sql = sql & "    AND s.deleted_at IS NULL;" & vbCrLf

    SaveQuery "sparepart_find_by_name", sql
End Sub

