'----------------------------------------------------------------------
' transaction_create.sql
' Query   : transaction_create
' Type    : APPEND
' Purpose : Create a document header. Pass p_activated_at = Null for a
'           draft (e.g. the proposed side of an update request), or
'           Now() for a document that is active immediately.
' Replaces: create_transaction
'----------------------------------------------------------------------
Public Sub Query_transaction_create()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_uuid] Text(36)," & vbCrLf
    sql = sql & "    [p_transaction_type] Text(15)," & vbCrLf
    sql = sql & "    [p_manufacturing_plant_id] Long," & vbCrLf
    sql = sql & "    [p_created_by] Text(64)," & vbCrLf
    sql = sql & "    [p_activated_at] DateTime;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "INSERT INTO" & vbCrLf
    sql = sql & "    transactions" & vbCrLf
    sql = sql & "        (" & vbCrLf
    sql = sql & "            uuid," & vbCrLf
    sql = sql & "            transaction_type," & vbCrLf
    sql = sql & "            manufacturing_plant_id," & vbCrLf
    sql = sql & "            created_by," & vbCrLf
    sql = sql & "            created_at," & vbCrLf
    sql = sql & "            activated_at" & vbCrLf
    sql = sql & "        )" & vbCrLf
    sql = sql & "    VALUES" & vbCrLf
    sql = sql & "        (" & vbCrLf
    sql = sql & "            [p_uuid]," & vbCrLf
    sql = sql & "            [p_transaction_type]," & vbCrLf
    sql = sql & "            [p_manufacturing_plant_id]," & vbCrLf
    sql = sql & "            [p_created_by]," & vbCrLf
    sql = sql & "            Now()," & vbCrLf
    sql = sql & "            [p_activated_at]" & vbCrLf
    sql = sql & "        );" & vbCrLf

    SaveQuery "transaction_create", sql
End Sub

'----------------------------------------------------------------------
' transaction_get_next_uuid.sql
' Query   : transaction_get_next_uuid
' Type    : SELECT
' Purpose : Next free document number
'           <PLANT>-<PREFIX>-<yyyymmdd>-<nnn>,
'           e.g. SBY01-ORD-20261124-001.
'           <PLANT> is manufacturing_plants.code (max 15 chars, so the
'           number is at most 32 chars and fits transactions.uuid).
'           Prefixes come from serviceTransaction: ORD, RCV, WRQ, MTW.
'           Numbering restarts at 001 per plant, prefix and day.
'           next_uuid is Null once 999 is used: the day is full for
'           that plant and prefix (the caller reports it).
'           A range on [uuid] (instead of Left/Mid) lets Access use
'           the unique index. uq_transactions_uuid still rejects a
'           number taken by another user in the meantime.
' Replaces: select_uuid
'----------------------------------------------------------------------
Public Sub Query_transaction_get_next_uuid()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_manufacturing_plant_code] Text(15)," & vbCrLf
    sql = sql & "    [p_uuid_prefix] Text(3)," & vbCrLf
    sql = sql & "    [p_transaction_date] DateTime;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    IIf(" & vbCrLf
    sql = sql & "        Max(Val(Right(t.uuid, 3))) >= 999," & vbCrLf
    sql = sql & "        Null," & vbCrLf
    sql = sql & "        UCase(Trim([p_manufacturing_plant_code]))" & vbCrLf
    sql = sql & "            & '-'" & vbCrLf
    sql = sql & "            & UCase([p_uuid_prefix])" & vbCrLf
    sql = sql & "            & '-'" & vbCrLf
    sql = sql & "            & Format([p_transaction_date], 'yyyymmdd')" & vbCrLf
    sql = sql & "            & '-'" & vbCrLf
    sql = sql & "            & Format(" & vbCrLf
    sql = sql & "                IIf(" & vbCrLf
    sql = sql & "                    Max(Val(Right(t.uuid, 3))) IS NULL," & vbCrLf
    sql = sql & "                    1," & vbCrLf
    sql = sql & "                    Max(Val(Right(t.uuid, 3))) + 1" & vbCrLf
    sql = sql & "                )," & vbCrLf
    sql = sql & "                '000'" & vbCrLf
    sql = sql & "            )" & vbCrLf
    sql = sql & "    ) AS next_uuid" & vbCrLf
    sql = sql & "FROM" & vbCrLf
    sql = sql & "    transactions AS t" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    t.uuid >= UCase(Trim([p_manufacturing_plant_code]))" & vbCrLf
    sql = sql & "        & '-'" & vbCrLf
    sql = sql & "        & UCase([p_uuid_prefix])" & vbCrLf
    sql = sql & "        & '-'" & vbCrLf
    sql = sql & "        & Format([p_transaction_date], 'yyyymmdd')" & vbCrLf
    sql = sql & "        & '-000'" & vbCrLf
    sql = sql & "    AND t.uuid <= UCase(Trim([p_manufacturing_plant_code]))" & vbCrLf
    sql = sql & "        & '-'" & vbCrLf
    sql = sql & "        & UCase([p_uuid_prefix])" & vbCrLf
    sql = sql & "        & '-'" & vbCrLf
    sql = sql & "        & Format([p_transaction_date], 'yyyymmdd')" & vbCrLf
    sql = sql & "        & '-999';" & vbCrLf

    SaveQuery "transaction_get_next_uuid", sql
End Sub

