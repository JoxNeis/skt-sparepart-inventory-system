'----------------------------------------------------------------------
' transaction_update_request_update.sql
' Query   : transaction_update_request_update
' Type    : UPDATE
' Purpose : Record the verdict ('APPROVED' or 'REJECTED') on a pending
'           update request.
'           0 rows affected = not pending, an unknown verdict, or the
'           reviewer's tier is not higher than the requester's (same
'           rule as user_check_can_approve, enforced here as well).
'           In the same ADO transaction the caller then:
'             APPROVED -> reverses the original transaction and
'                         activates the proposed one
'             REJECTED -> reverses the proposed draft so it can never
'                         be activated
' Replaces: transaction_update_request_approve,
'           transaction_update_request_reject
'----------------------------------------------------------------------
Public Sub Query_transaction_update_request_update()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_update_request_id] Long," & vbCrLf
    sql = sql & "    [p_verdict] Text(10)," & vbCrLf
    sql = sql & "    [p_reviewer] Text(64)," & vbCrLf
    sql = sql & "    [p_decision_note] LongText;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "UPDATE" & vbCrLf
    sql = sql & "    transaction_update_requests AS ur" & vbCrLf
    sql = sql & "SET" & vbCrLf
    sql = sql & "    ur.verdict = [p_verdict]," & vbCrLf
    sql = sql & "    ur.reviewer = [p_reviewer]," & vbCrLf
    sql = sql & "    ur.reviewed_at = Now()," & vbCrLf
    sql = sql & "    ur.decision_note = [p_decision_note]" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    ur.id = [p_update_request_id]" & vbCrLf
    sql = sql & "    AND ur.verdict IS NULL" & vbCrLf
    sql = sql & "    AND [p_verdict] IN ('APPROVED', 'REJECTED')" & vbCrLf
    sql = sql & "    AND EXISTS" & vbCrLf
    sql = sql & "        (" & vbCrLf
    sql = sql & "            SELECT" & vbCrLf
    sql = sql & "                1" & vbCrLf
    sql = sql & "            FROM" & vbCrLf
    sql = sql & "                users AS reviewer," & vbCrLf
    sql = sql & "                users AS requester" & vbCrLf
    sql = sql & "            WHERE" & vbCrLf
    sql = sql & "                reviewer.username = [p_reviewer]" & vbCrLf
    sql = sql & "                AND requester.username = ur.requested_by" & vbCrLf
    sql = sql & "                AND reviewer.deleted_at IS NULL" & vbCrLf
    sql = sql & "                AND reviewer.tier > requester.tier" & vbCrLf
    sql = sql & "        );" & vbCrLf

    SaveQuery "transaction_update_request_update", sql
End Sub

