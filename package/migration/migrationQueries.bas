    sql = sql & "                Choose([p_filter_index]," & vbCrLf
    sql = sql & "                    l.uuid," & vbCrLf
    sql = sql & "                    l.po_number," & vbCrLf
    sql = sql & "                    l.sparepart_display," & vbCrLf
