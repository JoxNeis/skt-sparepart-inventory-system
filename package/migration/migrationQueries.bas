    sql = sql & "                    l.order_date_text," & vbCrLf
    sql = sql & "                    l.estimated_arrival_text," & vbCrLf
    sql = sql & "                    l.status," & vbCrLf
    sql = sql & "                    l.remarks," & vbCrLf
