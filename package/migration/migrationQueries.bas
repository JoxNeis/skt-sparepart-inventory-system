'----------------------------------------------------------------------
' user_check_can_approve.sql
' Query   : user_check_can_approve
' Type    : SELECT
' Purpose : True when the approver's tier is higher than the
'           requester's. No row when either user is unknown or the
'           approver is archived.
' Replaces: compare_user
'----------------------------------------------------------------------
Public Sub Query_user_check_can_approve()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_requested_by] Text(64)," & vbCrLf
    sql = sql & "    [p_approved_by] Text(64);" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    IIf(" & vbCrLf
    sql = sql & "        approver.tier > requester.tier," & vbCrLf
    sql = sql & "        True," & vbCrLf
    sql = sql & "        False" & vbCrLf
    sql = sql & "    ) AS can_approve" & vbCrLf
    sql = sql & "FROM" & vbCrLf
    sql = sql & "    users AS requester," & vbCrLf
    sql = sql & "    users AS approver" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    requester.username = [p_requested_by]" & vbCrLf
    sql = sql & "    AND approver.username = [p_approved_by]" & vbCrLf
    sql = sql & "    AND approver.deleted_at IS NULL;" & vbCrLf

    SaveQuery "user_check_can_approve", sql
End Sub

