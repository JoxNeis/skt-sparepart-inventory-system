'----------------------------------------------------------------------
' transaction_update_request_create.sql
' Query   : transaction_update_request_create
' Type    : APPEND
' Purpose : Ask for an active transaction (p_original_uuid) to be
'           replaced by a draft one (p_proposed_uuid).
'           Inserts nothing (0 rows) unless: both exist, same type,
'           same plant, the original is active, the proposal is still
'           a draft, and the original has no other pending request.
' Replaces: create_transaction_update_request
'----------------------------------------------------------------------
Public Sub Query_transaction_update_request_create()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_original_uuid] Text(36)," & vbCrLf
    sql = sql & "    [p_proposed_uuid] Text(36)," & vbCrLf
    sql = sql & "    [p_reason] LongText," & vbCrLf
    sql = sql & "    [p_requested_by] Text(64);" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "INSERT INTO" & vbCrLf
    sql = sql & "    transaction_update_requests" & vbCrLf
    sql = sql & "        (" & vbCrLf
    sql = sql & "            original_transaction_id," & vbCrLf
    sql = sql & "            proposed_transaction_id," & vbCrLf
    sql = sql & "            reason," & vbCrLf
    sql = sql & "            requested_by," & vbCrLf
    sql = sql & "            requested_at" & vbCrLf
    sql = sql & "        )" & vbCrLf
    sql = sql & "    SELECT" & vbCrLf
    sql = sql & "        old_t.id AS original_transaction_id," & vbCrLf
    sql = sql & "        new_t.id AS proposed_transaction_id," & vbCrLf
    sql = sql & "        [p_reason] AS reason," & vbCrLf
    sql = sql & "        [p_requested_by] AS requested_by," & vbCrLf
    sql = sql & "        Now() AS requested_at" & vbCrLf
    sql = sql & "    FROM" & vbCrLf
    sql = sql & "        transactions AS old_t," & vbCrLf
    sql = sql & "        transactions AS new_t" & vbCrLf
    sql = sql & "    WHERE" & vbCrLf
    sql = sql & "        old_t.uuid = [p_original_uuid]" & vbCrLf
    sql = sql & "        AND new_t.uuid = [p_proposed_uuid]" & vbCrLf
    sql = sql & "        AND new_t.transaction_type = old_t.transaction_type" & vbCrLf
    sql = sql & "        AND new_t.manufacturing_plant_id = old_t.manufacturing_plant_id" & vbCrLf
    sql = sql & "        AND old_t.activated_at IS NOT NULL" & vbCrLf
    sql = sql & "        AND old_t.reversed_at IS NULL" & vbCrLf
    sql = sql & "        AND new_t.activated_at IS NULL" & vbCrLf
    sql = sql & "        AND NOT EXISTS" & vbCrLf
    sql = sql & "            (" & vbCrLf
    sql = sql & "                SELECT" & vbCrLf
    sql = sql & "                    1" & vbCrLf
    sql = sql & "                FROM" & vbCrLf
    sql = sql & "                    transaction_update_requests AS ur" & vbCrLf
    sql = sql & "                WHERE" & vbCrLf
    sql = sql & "                    ur.original_transaction_id = old_t.id" & vbCrLf
    sql = sql & "                    AND ur.verdict IS NULL" & vbCrLf
    sql = sql & "            );" & vbCrLf

    SaveQuery "transaction_update_request_create", sql
End Sub

'----------------------------------------------------------------------
' transaction_update_request_list.sql
' Query   : transaction_update_request_list
' Type    : SELECT
' Purpose : Update requests of a plant REQUESTED p_date_from ..
'           p_date_to (whole days, both inclusive), for every document
'           type, with the old and new values side by side.
'           Pending requests have verdict IS NULL.
'           One row shape for all types (UNION ALL); a column that does
'           not apply to a type is NULL:
'             document_date    ORDER: order_date
'                              RECEIVE: arrival_date
'                              REQUEST: request_date
'             quantity         ORDER, REQUEST: quantity
'                              RECEIVE: received_quantity
'             order_uuid, po_number, vendor_name
'                              ORDER: its own
'                              RECEIVE: those of the received order
'             ok_quantity, not_ok_quantity   RECEIVE only
'             mobile_maintenance_name        REQUEST only
' Replaces: transaction_update_request_list_order,
'           transaction_update_request_list_receive,
'           transaction_update_request_list_request
'----------------------------------------------------------------------
Public Sub Query_transaction_update_request_list()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_manufacturing_plant_id] Long," & vbCrLf
    sql = sql & "    [p_date_from] DateTime," & vbCrLf
    sql = sql & "    [p_date_to] DateTime;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    ur.id AS id," & vbCrLf
    sql = sql & "    old_t.transaction_type AS transaction_type," & vbCrLf
    sql = sql & "    ur.reason AS reason," & vbCrLf
    sql = sql & "    ur.requested_by AS requested_by," & vbCrLf
    sql = sql & "    ur.requested_at AS requested_at," & vbCrLf
    sql = sql & "    ur.verdict AS verdict," & vbCrLf
    sql = sql & "    ur.reviewer AS reviewer," & vbCrLf
    sql = sql & "    ur.reviewed_at AS reviewed_at," & vbCrLf
    sql = sql & "    ur.decision_note AS decision_note," & vbCrLf
    sql = sql & "    p.[name] AS manufacturing_plant_name," & vbCrLf
    sql = sql & "    old_t.uuid AS old_transaction_uuid," & vbCrLf
