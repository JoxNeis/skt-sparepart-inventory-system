'----------------------------------------------------------------------
' vw_transaction_active.sql
' Query   : vw_transaction_active
' Type    : SELECT (view - no parameters, used by other queries)
' Purpose : Transactions that count: activated and not reversed.
'           The one place where "active" is defined.
'----------------------------------------------------------------------
Public Sub Query_vw_transaction_active()
    Dim sql As String

    sql = ""
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    t.id AS id," & vbCrLf
    sql = sql & "    t.uuid AS uuid," & vbCrLf
    sql = sql & "    t.transaction_type AS transaction_type," & vbCrLf
    sql = sql & "    t.manufacturing_plant_id AS manufacturing_plant_id," & vbCrLf
    sql = sql & "    t.created_by AS created_by," & vbCrLf
    sql = sql & "    t.created_at AS created_at," & vbCrLf
    sql = sql & "    t.activated_at AS activated_at" & vbCrLf
    sql = sql & "FROM" & vbCrLf
    sql = sql & "    transactions AS t" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    t.activated_at IS NOT NULL" & vbCrLf
    sql = sql & "    AND t.reversed_at IS NULL;" & vbCrLf

    SaveQuery "vw_transaction_active", sql
End Sub

'----------------------------------------------------------------------
' vw_receive_active.sql
' Query   : vw_receive_active
' Type    : SELECT (view - no parameters, used by other queries)
' Purpose : Receives whose transaction is active, with the header's
'           document number, plant and activation time.
'----------------------------------------------------------------------
' Uses    : vw_transaction_active
Public Sub Query_vw_receive_active()
    Dim sql As String

    sql = ""
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    r.id AS id," & vbCrLf
    sql = sql & "    r.transaction_id AS transaction_id," & vbCrLf
    sql = sql & "    r.order_id AS order_id," & vbCrLf
    sql = sql & "    t.uuid AS uuid," & vbCrLf
    sql = sql & "    t.manufacturing_plant_id AS manufacturing_plant_id," & vbCrLf
    sql = sql & "    t.activated_at AS activated_at," & vbCrLf
    sql = sql & "    r.arrival_date AS arrival_date," & vbCrLf
    sql = sql & "    r.verification_date AS verification_date," & vbCrLf
    sql = sql & "    r.received_quantity AS received_quantity," & vbCrLf
    sql = sql & "    r.ok_quantity AS ok_quantity," & vbCrLf
    sql = sql & "    r.not_ok_quantity AS not_ok_quantity," & vbCrLf
    sql = sql & "    r.remarks AS remarks," & vbCrLf
    sql = sql & "    r.system_remarks AS system_remarks," & vbCrLf
    sql = sql & "    r.person_in_charge AS person_in_charge" & vbCrLf
    sql = sql & "FROM" & vbCrLf
    sql = sql & "    receives AS r" & vbCrLf
    sql = sql & "        INNER JOIN vw_transaction_active AS t" & vbCrLf
    sql = sql & "            ON t.id = r.transaction_id;" & vbCrLf

