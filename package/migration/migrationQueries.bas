    sql = sql & "    [p_tier] Long;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "UPDATE" & vbCrLf
    sql = sql & "    users" & vbCrLf
    sql = sql & "SET" & vbCrLf
