'----------------------------------------------------------------------
' manufacturing_plant_stock_list.sql
' Query   : manufacturing_plant_stock_list
' Type    : SELECT (one page)
' Purpose : Stock and ROP planning figures of the catalogue spareparts
'           in a plant (REKAP INVENTORY, dashboard, stock checks).
' Filter  : p_filter_value searched (contains, ignoring case) in
'           "code - name" and alias; blank = no filter.
' Paging  : keyset, sorted by (sparepart name, stock row id).
'           p_direction 'NEXT' = rows after  (p_key_text, p_key_id)
'           p_direction 'PREV' = rows before (p_key_text, p_key_id)
'           First page: 'NEXT' from ('', 0).
'           Total rows: manufacturing_plant_stock_count.
' Replaces: select_plant_stocks
'----------------------------------------------------------------------
Public Sub Query_manufacturing_plant_stock_list()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_manufacturing_plant_id] Long," & vbCrLf
    sql = sql & "    [p_filter_value] Text(255)," & vbCrLf
    sql = sql & "    [p_direction] Text(4)," & vbCrLf
    sql = sql & "    [p_key_text] Text(255)," & vbCrLf
    sql = sql & "    [p_key_id] Long;" & vbCrLf
    sql = sql & "SELECT" & vbCrLf
    sql = sql & "    ps.id AS id," & vbCrLf
    sql = sql & "    ps.current_stock AS current_stock," & vbCrLf
    sql = sql & "    ps.reorder_point AS reorder_point," & vbCrLf
    sql = sql & "    ps.safety_stock AS safety_stock," & vbCrLf
    sql = sql & "    ps.lead_time_days AS lead_time_days," & vbCrLf
    sql = sql & "    ps.average_daily_usage AS average_daily_usage," & vbCrLf
    sql = sql & "    ps.daily_demand_std_dev AS daily_demand_std_dev," & vbCrLf
    sql = sql & "    ps.service_level_z AS service_level_z," & vbCrLf
    sql = sql & "    IIf(" & vbCrLf
    sql = sql & "        ps.current_stock <= ps.reorder_point," & vbCrLf
    sql = sql & "        True," & vbCrLf
    sql = sql & "        False" & vbCrLf
    sql = sql & "    ) AS is_at_reorder_point," & vbCrLf
    sql = sql & "    s.id AS sparepart_id," & vbCrLf
    sql = sql & "    s.code AS sparepart_code," & vbCrLf
    sql = sql & "    s.[name] AS sparepart_name," & vbCrLf
    sql = sql & "    s.unit_of_measurement AS sparepart_unit_of_measurement" & vbCrLf
    sql = sql & "FROM" & vbCrLf
    sql = sql & "    manufacturing_plant_stocks AS ps" & vbCrLf
    sql = sql & "        INNER JOIN spareparts AS s" & vbCrLf
    sql = sql & "            ON s.id = ps.sparepart_id" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    ps.manufacturing_plant_id = [p_manufacturing_plant_id]" & vbCrLf
    sql = sql & "    AND s.deleted_at IS NULL" & vbCrLf
    sql = sql & "    AND (" & vbCrLf
    sql = sql & "        [p_filter_value] IS NULL" & vbCrLf
    sql = sql & "        OR InStr(1, s.code & ' - ' & s.[name] & '|' & s.alias, [p_filter_value]) > 0" & vbCrLf
    sql = sql & "    )" & vbCrLf
    sql = sql & "    AND IIf(" & vbCrLf
    sql = sql & "        [p_direction] = 'PREV'," & vbCrLf
    sql = sql & "        s.[name] < [p_key_text]" & vbCrLf
    sql = sql & "            OR (s.[name] = [p_key_text] AND ps.id < [p_key_id])," & vbCrLf
    sql = sql & "        s.[name] > [p_key_text]" & vbCrLf
    sql = sql & "            OR (s.[name] = [p_key_text] AND ps.id > [p_key_id])" & vbCrLf
    sql = sql & "    )" & vbCrLf
    sql = sql & "ORDER BY" & vbCrLf
    sql = sql & "    s.[name]," & vbCrLf
    sql = sql & "    ps.id;" & vbCrLf

    SaveQuery "manufacturing_plant_stock_list", sql
End Sub

'----------------------------------------------------------------------
' manufacturing_plant_stock_recalculate_reorder_point.sql
' Query   : manufacturing_plant_stock_recalculate_reorder_point
' Type    : UPDATE
' Purpose : Store new demand inputs and recalculate the ROP outputs:
'             safety_stock  = Z * std_dev * Sqr(lead_time)
'             reorder_point = safety_stock + usage * lead_time
'           Z is the row's service_level_z (default 1.65).
'           Results are rounded UP to whole units (-Int(-x) is the
'           ceiling); Round(x, 6) first drops floating-point noise
'           such as 11.000000000000002.
' Replaces: update_rop
'----------------------------------------------------------------------
Public Sub Query_manufacturing_plant_stock_recalculate_reorder_point()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_manufacturing_plant_id] Long," & vbCrLf
    sql = sql & "    [p_sparepart_id] Long," & vbCrLf
    sql = sql & "    [p_lead_time_days] Long," & vbCrLf
    sql = sql & "    [p_average_daily_usage] IEEEDouble," & vbCrLf
    sql = sql & "    [p_daily_demand_std_dev] IEEEDouble;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "UPDATE" & vbCrLf
    sql = sql & "    manufacturing_plant_stocks" & vbCrLf
    sql = sql & "SET" & vbCrLf
    sql = sql & "    lead_time_days = [p_lead_time_days]," & vbCrLf
    sql = sql & "    average_daily_usage = [p_average_daily_usage]," & vbCrLf
    sql = sql & "    daily_demand_std_dev = [p_daily_demand_std_dev]," & vbCrLf
    sql = sql & "    safety_stock = -Int(" & vbCrLf
    sql = sql & "        -Round(" & vbCrLf
    sql = sql & "            service_level_z" & vbCrLf
    sql = sql & "            * [p_daily_demand_std_dev]" & vbCrLf
    sql = sql & "            * Sqr([p_lead_time_days])," & vbCrLf
    sql = sql & "            6" & vbCrLf
    sql = sql & "        )" & vbCrLf
    sql = sql & "    )," & vbCrLf
    sql = sql & "    reorder_point = -Int(" & vbCrLf
    sql = sql & "        -Round(" & vbCrLf
    sql = sql & "            service_level_z" & vbCrLf
    sql = sql & "            * [p_daily_demand_std_dev]" & vbCrLf
    sql = sql & "            * Sqr([p_lead_time_days])" & vbCrLf
    sql = sql & "            + [p_average_daily_usage] * [p_lead_time_days]," & vbCrLf
    sql = sql & "            6" & vbCrLf
    sql = sql & "        )" & vbCrLf
    sql = sql & "    )," & vbCrLf
    sql = sql & "    updated_at = Now()" & vbCrLf
    sql = sql & "WHERE" & vbCrLf
    sql = sql & "    manufacturing_plant_id = [p_manufacturing_plant_id]" & vbCrLf
    sql = sql & "    AND sparepart_id = [p_sparepart_id];" & vbCrLf

    SaveQuery "manufacturing_plant_stock_recalculate_reorder_point", sql
End Sub

'----------------------------------------------------------------------
' manufacturing_plant_stock_set_current_stock.sql
' Query   : manufacturing_plant_stock_set_current_stock
' Type    : UPDATE
' Purpose : Overwrite the cached stock with an absolute value
'           (stock take / re-sync from vw_stock_ledger).
'           0 rows affected = no stock row, or p_current_stock < 0.
' Replaces: update_current_stock_exact
'----------------------------------------------------------------------
Public Sub Query_manufacturing_plant_stock_set_current_stock()
    Dim sql As String

    sql = ""
    sql = sql & "PARAMETERS" & vbCrLf
    sql = sql & "    [p_manufacturing_plant_id] Long," & vbCrLf
    sql = sql & "    [p_sparepart_id] Long," & vbCrLf
    sql = sql & "    [p_current_stock] Long;" & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "UPDATE" & vbCrLf
