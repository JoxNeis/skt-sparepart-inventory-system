'----------------------------------------------------------------------
' 12_transaction_update_requests.sql
' Table  : transaction_update_requests
' Purpose: Approval workflow for editing an active transaction. The
'          edit is stored as a new draft (proposed) transaction.
'          Approving reverses the original and activates the proposal.
' Life   : pending  -> verdict IS NULL
'          approved -> verdict = 'APPROVED'
'          rejected -> verdict = 'REJECTED'
'          [reviewer] and [reviewed_at] are set together with
'          [verdict], and are NULL while the request is pending.
' Notes  : original_transaction_id is no longer unique, so a
'          transaction can be requested again after a rejection.
'          The old composite FK (original, proposed) -> (id, id) is
'          replaced by two separate foreign keys.
'----------------------------------------------------------------------
Public Sub Table_12_transaction_update_requests()
    Dim sql As String

    sql = ""
    sql = sql & "CREATE TABLE [transaction_update_requests] (" & vbCrLf
    sql = sql & "    [id]                       AUTOINCREMENT," & vbCrLf
    sql = sql & "    [original_transaction_id]  LONG      NOT NULL," & vbCrLf
    sql = sql & "    [proposed_transaction_id]  LONG      NOT NULL," & vbCrLf
    sql = sql & "    [reason]                   LONGTEXT," & vbCrLf
    sql = sql & "    [requested_by]             TEXT(64)  NOT NULL," & vbCrLf
    sql = sql & "    [requested_at]             DATETIME  NOT NULL DEFAULT Now()," & vbCrLf
    sql = sql & "    [verdict]                  TEXT(10)," & vbCrLf
    sql = sql & "    [reviewer]                 TEXT(64)," & vbCrLf
    sql = sql & "    [reviewed_at]              DATETIME," & vbCrLf
    sql = sql & "    [decision_note]            LONGTEXT," & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [pk_transaction_update_requests]" & vbCrLf
    sql = sql & "            PRIMARY KEY ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [uq_transaction_update_requests_proposed_transaction]" & vbCrLf
    sql = sql & "            UNIQUE ([proposed_transaction_id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_transaction_update_requests_original_transaction]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([original_transaction_id])" & vbCrLf
    sql = sql & "                REFERENCES [transactions] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_transaction_update_requests_proposed_transaction]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([proposed_transaction_id])" & vbCrLf
    sql = sql & "                REFERENCES [transactions] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_transaction_update_requests_requested_by]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([requested_by])" & vbCrLf
    sql = sql & "                REFERENCES [users] ([username])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_transaction_update_requests_reviewer]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([reviewer])" & vbCrLf
    sql = sql & "                REFERENCES [users] ([username])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [ck_transaction_update_requests_verdict]" & vbCrLf
    sql = sql & "            CHECK (" & vbCrLf
    sql = sql & "                [original_transaction_id] <> [proposed_transaction_id]" & vbCrLf
    sql = sql & "                AND (" & vbCrLf
    sql = sql & "                    (" & vbCrLf
    sql = sql & "                        [verdict] IS NULL" & vbCrLf
    sql = sql & "                        AND [reviewer] IS NULL" & vbCrLf
    sql = sql & "                        AND [reviewed_at] IS NULL" & vbCrLf
    sql = sql & "                    )" & vbCrLf
    sql = sql & "                    OR (" & vbCrLf
    sql = sql & "                        [verdict] IN ('APPROVED', 'REJECTED')" & vbCrLf
    sql = sql & "                        AND [reviewer] IS NOT NULL" & vbCrLf
    sql = sql & "                        AND [reviewed_at] IS NOT NULL" & vbCrLf
    sql = sql & "                    )" & vbCrLf
    sql = sql & "                )" & vbCrLf
    sql = sql & "            )" & vbCrLf
    sql = sql & ")" & vbCrLf
    EnsureTable "transaction_update_requests", sql

    ' Columns added later are created on an existing table.
    EnsureColumn "transaction_update_requests", "original_transaction_id", "LONG NOT NULL"
    EnsureColumn "transaction_update_requests", "proposed_transaction_id", "LONG NOT NULL"
    EnsureColumn "transaction_update_requests", "reason", "LONGTEXT"
    EnsureColumn "transaction_update_requests", "requested_by", "TEXT(64) NOT NULL"
    EnsureColumn "transaction_update_requests", "requested_at", "DATETIME NOT NULL DEFAULT Now()"
    EnsureColumn "transaction_update_requests", "verdict", "TEXT(10)"
    EnsureColumn "transaction_update_requests", "reviewer", "TEXT(64)"
    EnsureColumn "transaction_update_requests", "reviewed_at", "DATETIME"
    EnsureColumn "transaction_update_requests", "decision_note", "LONGTEXT"

    sql = ""
    sql = sql & "CREATE INDEX" & vbCrLf
    sql = sql & "    [idx_transaction_update_requests_requested_at]" & vbCrLf
    sql = sql & "        ON [transaction_update_requests] ([requested_at])" & vbCrLf
    EnsureIndex "transaction_update_requests", "idx_transaction_update_requests_requested_at", sql

    sql = ""
    sql = sql & "CREATE INDEX" & vbCrLf
    sql = sql & "    [idx_transaction_update_requests_verdict]" & vbCrLf
    sql = sql & "        ON [transaction_update_requests] ([verdict])" & vbCrLf
    EnsureIndex "transaction_update_requests", "idx_transaction_update_requests_verdict", sql
End Sub

'----------------------------------------------------------------------
' 13_maintenance_works.sql
' Table  : maintenance_works
' Purpose: Detail of a MAINTENANCE transaction - one mobile maintenance
'          job done on a date. Its tasks and the spareparts used live in
'          maintenance_work_details. The document number (MTW-...) and
'          the plant come from the transaction header.
' Notes  : [maintenance_type] is free text for now, e.g. PREVENTIVE or
