'----------------------------------------------------------------------
' 15_assemblies.sql
' Table  : assemblies
' Purpose: Bill of materials - links a parent sparepart to the child
'          spareparts it is assembled from.
' Notes  : Both [parent_id] and [child_id] reference spareparts.
'          A parent/child pair is unique, and a sparepart cannot be its
'          own child.
'----------------------------------------------------------------------
Public Sub Table_15_assemblies()
    Dim sql As String

    sql = ""
    sql = sql & "CREATE TABLE [assemblies] (" & vbCrLf
    sql = sql & "    [id]          AUTOINCREMENT," & vbCrLf
    sql = sql & "    [parent_id]   LONG      NOT NULL," & vbCrLf
    sql = sql & "    [child_id]    LONG      NOT NULL," & vbCrLf
    sql = sql & "    [created_at]  DATETIME  NOT NULL DEFAULT Now()," & vbCrLf
    sql = sql & "    [updated_at]  DATETIME," & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [pk_assemblies]" & vbCrLf
    sql = sql & "            PRIMARY KEY ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [uq_assemblies_parent_child]" & vbCrLf
    sql = sql & "            UNIQUE ([parent_id], [child_id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_assemblies_parent]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([parent_id])" & vbCrLf
    sql = sql & "                REFERENCES [spareparts] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_assemblies_child]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([child_id])" & vbCrLf
    sql = sql & "                REFERENCES [spareparts] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [ck_assemblies_not_self]" & vbCrLf
    sql = sql & "            CHECK ([parent_id] <> [child_id])" & vbCrLf
    sql = sql & ")" & vbCrLf
    EnsureTable "assemblies", sql

    ' Columns added later are created on an existing table.
    EnsureColumn "assemblies", "parent_id", "LONG NOT NULL"
    EnsureColumn "assemblies", "child_id", "LONG NOT NULL"
    EnsureColumn "assemblies", "created_at", "DATETIME NOT NULL DEFAULT Now()"
    EnsureColumn "assemblies", "updated_at", "DATETIME"

    sql = ""
    sql = sql & "CREATE INDEX" & vbCrLf
    sql = sql & "    [idx_assemblies_child]" & vbCrLf
    sql = sql & "        ON [assemblies] ([child_id])" & vbCrLf
    EnsureIndex "assemblies", "idx_assemblies_child", sql
End Sub

'======================================================================
' Helpers
'======================================================================

Private Sub EnsureTable(ByVal tableName As String, ByVal sql As String)
    If TableExists(tableName) Then
        migrationInit.MigrationLog "  skipped   table " & tableName & " (exists)"
    Else
        migrationInit.ExecuteDdl sql, "table " & tableName
    End If
End Sub

' Adds a column to an existing table when it is missing (silent when it exists).
Private Sub EnsureColumn(ByVal tableName As String, ByVal columnName As String, ByVal definition As String)
    If FieldExists(tableName, columnName) Then Exit Sub
    migrationInit.ExecuteDdl _
        "ALTER TABLE [" & tableName & "] ADD COLUMN [" & columnName & "] " & definition, _
        "column " & tableName & "." & columnName
End Sub

Private Sub EnsureIndex(ByVal tableName As String, ByVal indexName As String, ByVal sql As String)
    If IndexExists(tableName, indexName) Then
        migrationInit.MigrationLog "  skipped   index " & indexName & " (exists)"
    Else
        migrationInit.ExecuteDdl sql, "index " & indexName & " on " & tableName
    End If
End Sub

' Adds a calculated field through DAO (Field2.Expression).
Private Sub EnsureCalculatedField(ByVal tableName As String, ByVal fieldName As String, _
                                  ByVal fieldType As Long, ByVal expression As String)
    Dim db As Object       ' DAO.Database
    Dim tdf As Object      ' DAO.TableDef
    Dim fld As Object      ' DAO.Field2

    If FieldExists(tableName, fieldName) Then
        migrationInit.MigrationLog "  skipped   field " & tableName & "." & fieldName & " (exists)"
        Exit Sub
    End If

    migrationInit.SetCurrentObject "calculated field " & tableName & "." & fieldName, expression

    ' The table was created through ADO; make DAO see it.
    DBEngine.Idle DB_REFRESH_CACHE
    Set db = CurrentDb
    db.TableDefs.Refresh
    Set tdf = db.TableDefs(tableName)

    If fieldType = DB_TEXT Then
        Set fld = tdf.CreateField(fieldName, fieldType, 255)
    Else
        Set fld = tdf.CreateField(fieldName, fieldType)
    End If
    fld.expression = expression
    tdf.Fields.Append fld

    migrationInit.MigrationLog "  created   calculated field " & tableName & "." & fieldName
End Sub

' Adds a one-to-one relation through DAO (dbRelationUnique): each
' tableName.fieldName row has at most one foreignTableName row. A
' relation with the same name that is not one-to-one (a FOREIGN KEY
' from an older version) is dropped and created again.
Private Sub EnsureOneToOneRelation(ByVal relationName As String, _
                                   ByVal tableName As String, ByVal fieldName As String, _
                                   ByVal foreignTableName As String, ByVal foreignFieldName As String)
    Dim db As Object       ' DAO.Database
    Dim rel As Object      ' DAO.Relation
    Dim fld As Object      ' DAO.Field
    Dim isOneToMany As Boolean

    migrationInit.SetCurrentObject "relation " & relationName, _
        tableName & "." & fieldName & " 1:1 " & foreignTableName & "." & foreignFieldName

    ' The tables were created through ADO; make DAO see them.
    DBEngine.Idle DB_REFRESH_CACHE
    Set db = CurrentDb
    db.TableDefs.Refresh
    db.Relations.Refresh

    For Each rel In db.Relations
        If StrComp(rel.Name, relationName, vbTextCompare) = 0 Then
            If (rel.Attributes And DB_RELATION_UNIQUE) <> 0 Then
                migrationInit.MigrationLog "  skipped   relation " & relationName & " (exists)"
                Exit Sub
            End If
            isOneToMany = True
            Exit For
        End If
    Next rel

    If isOneToMany Then
        db.Relations.Delete relationName
        migrationInit.MigrationLog "  dropped   relation " & relationName & " (was one-to-many)"
    End If

    Set rel = db.CreateRelation(relationName, tableName, foreignTableName, DB_RELATION_UNIQUE)
    Set fld = rel.CreateField(fieldName)
    fld.ForeignName = foreignFieldName
    rel.Fields.Append fld
    db.Relations.Append rel

    migrationInit.MigrationLog "  created   relation " & relationName & " (one-to-one)"
End Sub

Public Function TableExists(ByVal tableName As String) As Boolean
    Dim rs As Object
    Set rs = migrationInit.MigrationConnection.OpenSchema( _
        adSchemaTables, Array(Empty, Empty, tableName, "TABLE"))
    TableExists = Not rs.EOF
    rs.Close
End Function

Public Function IndexExists(ByVal tableName As String, ByVal indexName As String) As Boolean
    Dim rs As Object
    Set rs = migrationInit.MigrationConnection.OpenSchema( _
        adSchemaIndexes, Array(Empty, Empty, indexName, Empty, tableName))
    IndexExists = Not rs.EOF
    rs.Close
End Function

Public Function FieldExists(ByVal tableName As String, ByVal fieldName As String) As Boolean
    Dim rs As Object
    Set rs = migrationInit.MigrationConnection.OpenSchema( _
        adSchemaColumns, Array(Empty, Empty, tableName, fieldName))
    FieldExists = Not rs.EOF
    rs.Close
End Function
