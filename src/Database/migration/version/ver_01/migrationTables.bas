Attribute VB_Name = "migrationTables"
'======================================================================
' Module : migrationTables   (the table injector)
' Purpose: Creates every table of the schema, one procedure per table
'          file in src\Database\tables. A table, index, calculated
'          field or relation that already exists is skipped, so this is
'          safe to run again after a failure. A column that is in the
'          .sql file but missing from an existing table is added (ALTER
'          TABLE ADD COLUMN); columns are never changed or dropped.
'          A one-to-many relation that must be one-to-one is replaced.
'          Started by migrationInit.RunMigration.
' Version: 1 - initial_schema
' GENERATED by generate_migration_vba.ps1 from the .sql files.
' Do not edit by hand: change the .sql file and run the script again.
'======================================================================
Option Compare Database
Option Explicit

' Late bound (no reference to the DAO or ADO library needed).
Private Const DB_TEXT As Long = 10            ' dbText
Private Const DB_REFRESH_CACHE As Long = 8    ' dbRefreshCache
Private Const DB_RELATION_UNIQUE As Long = 1  ' dbRelationUnique
Private Const adSchemaColumns As Long = 4
Private Const adSchemaIndexes As Long = 12
Private Const adSchemaTables As Long = 20

'----------------------------------------------------------------------
' Create all tables, in dependency (file) order.
'----------------------------------------------------------------------
Public Sub ApplyTables()
    Table_00_migration
    Table_01_manufacturing_plants
    Table_02_users
    Table_03_activity_logs
    Table_04_vendors
    Table_05_spareparts
    Table_06_mobile_maintenances
    Table_07_manufacturing_plant_stocks
    Table_08_transactions
    Table_09_orders
    Table_10_receives
    Table_11_requests
    Table_12_transaction_update_requests
    Table_13_maintenance_works
    Table_14_maintenance_work_details
    Table_15_assemblies
End Sub

'----------------------------------------------------------------------
' 00_migration.sql
' Table  : migrations
' Purpose: Tracks which schema versions have been applied to this
'          database, so upgrade scripts run once and in order.
' Notes  : [version] is the migration number (e.g. 1, 2, 3...); the
'          current DB version is MAX([version]).
'          Rows are append-only; never edit or delete an applied row.
'----------------------------------------------------------------------
Public Sub Table_00_migration()
    Dim sql As String

    sql = ""
    sql = sql & "CREATE TABLE [migrations] (" & vbCrLf
    sql = sql & "    [id]          AUTOINCREMENT," & vbCrLf
    sql = sql & "    [version]     LONG       NOT NULL," & vbCrLf
    sql = sql & "    [name]        TEXT(100)  NOT NULL," & vbCrLf
    sql = sql & "    [applied_by]  TEXT(64)," & vbCrLf
    sql = sql & "    [applied_at]  DATETIME   NOT NULL DEFAULT Now()," & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [pk_migrations]" & vbCrLf
    sql = sql & "            PRIMARY KEY ([id])" & vbCrLf
    sql = sql & ")" & vbCrLf
    EnsureTable "migrations", sql

    ' Columns added later are created on an existing table.
    EnsureColumn "migrations", "version", "LONG NOT NULL"
    EnsureColumn "migrations", "name", "TEXT(100) NOT NULL"
    EnsureColumn "migrations", "applied_by", "TEXT(64)"
    EnsureColumn "migrations", "applied_at", "DATETIME NOT NULL DEFAULT Now()"

    sql = ""
    sql = sql & "CREATE UNIQUE INDEX" & vbCrLf
    sql = sql & "    [uq_migrations_version]" & vbCrLf
    sql = sql & "        ON [migrations] ([version])" & vbCrLf
    EnsureIndex "migrations", "uq_migrations_version", sql
End Sub

