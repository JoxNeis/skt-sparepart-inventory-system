'----------------------------------------------------------------------
' 07_manufacturing_plant_stocks.sql
' Table  : manufacturing_plant_stocks
' Purpose: One row per (plant, sparepart): the on-hand stock and the
'          reorder point (ROP) planning inputs and outputs.
' Notes  : current_stock is a cache of the stock ledger
'          (vw_stock_ledger), kept in step by the application.
'            safety_stock  = service_level_z * daily_demand_std_dev
'                            * Sqr(lead_time_days)
'            reorder_point = safety_stock
'                            + average_daily_usage * lead_time_days
'          service_level_z 1.65 = 95 % service level (was hard-coded
'          in update_rop).
'----------------------------------------------------------------------
Public Sub Table_07_manufacturing_plant_stocks()
    Dim sql As String

    sql = ""
    sql = sql & "CREATE TABLE [manufacturing_plant_stocks] (" & vbCrLf
    sql = sql & "    [id]                      AUTOINCREMENT," & vbCrLf
    sql = sql & "    [manufacturing_plant_id]  LONG      NOT NULL," & vbCrLf
    sql = sql & "    [sparepart_id]            LONG      NOT NULL," & vbCrLf
    sql = sql & "    [current_stock]           LONG      NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [reorder_point]           LONG      NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [safety_stock]            LONG      NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [lead_time_days]          LONG      NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [average_daily_usage]     DOUBLE    NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [daily_demand_std_dev]    DOUBLE    NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [service_level_z]         DOUBLE    NOT NULL DEFAULT 1.65," & vbCrLf
    sql = sql & "    [created_at]              DATETIME  NOT NULL DEFAULT Now()," & vbCrLf
    sql = sql & "    [updated_at]              DATETIME," & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [pk_manufacturing_plant_stocks]" & vbCrLf
    sql = sql & "            PRIMARY KEY ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [uq_manufacturing_plant_stocks_plant_sparepart]" & vbCrLf
    sql = sql & "            UNIQUE ([manufacturing_plant_id], [sparepart_id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_manufacturing_plant_stocks_manufacturing_plant]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([manufacturing_plant_id])" & vbCrLf
    sql = sql & "                REFERENCES [manufacturing_plants] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_manufacturing_plant_stocks_sparepart]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([sparepart_id])" & vbCrLf
    sql = sql & "                REFERENCES [spareparts] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [ck_manufacturing_plant_stocks_current_stocks]" & vbCrLf
    sql = sql & "            CHECK (" & vbCrLf
    sql = sql & "                [current_stock] >= 0" & vbCrLf
    sql = sql & "            )," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [ck_manufacturing_plant_stocks_planning]" & vbCrLf
    sql = sql & "            CHECK (" & vbCrLf
    sql = sql & "                [reorder_point] >= 0" & vbCrLf
    sql = sql & "                AND [safety_stock] >= 0" & vbCrLf
    sql = sql & "                AND [lead_time_days] >= 0" & vbCrLf
    sql = sql & "                AND [average_daily_usage] >= 0" & vbCrLf
    sql = sql & "                AND [daily_demand_std_dev] >= 0" & vbCrLf
    sql = sql & "                AND [service_level_z] >= 0" & vbCrLf
    sql = sql & "            )" & vbCrLf
    sql = sql & ")" & vbCrLf
    EnsureTable "manufacturing_plant_stocks", sql

    ' Columns added later are created on an existing table.
    EnsureColumn "manufacturing_plant_stocks", "manufacturing_plant_id", "LONG NOT NULL"
    EnsureColumn "manufacturing_plant_stocks", "sparepart_id", "LONG NOT NULL"
    EnsureColumn "manufacturing_plant_stocks", "current_stock", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "manufacturing_plant_stocks", "reorder_point", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "manufacturing_plant_stocks", "safety_stock", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "manufacturing_plant_stocks", "lead_time_days", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "manufacturing_plant_stocks", "average_daily_usage", "DOUBLE NOT NULL DEFAULT 0"
    EnsureColumn "manufacturing_plant_stocks", "daily_demand_std_dev", "DOUBLE NOT NULL DEFAULT 0"
    EnsureColumn "manufacturing_plant_stocks", "service_level_z", "DOUBLE NOT NULL DEFAULT 1.65"
    EnsureColumn "manufacturing_plant_stocks", "created_at", "DATETIME NOT NULL DEFAULT Now()"
