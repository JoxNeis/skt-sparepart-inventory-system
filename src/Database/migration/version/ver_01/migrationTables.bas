    sql = sql & "    [ok_quantity]        LONG       NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [not_ok_quantity]    LONG       NOT NULL DEFAULT 0," & vbCrLf
    sql = sql & "    [remarks]            LONGTEXT," & vbCrLf
    sql = sql & "    [system_remarks]     LONGTEXT," & vbCrLf
    sql = sql & "    [person_in_charge]   TEXT(255)," & vbCrLf
    sql = sql & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [pk_receives]" & vbCrLf
    sql = sql & "            PRIMARY KEY ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [uq_receives_transaction]" & vbCrLf
    sql = sql & "            UNIQUE ([transaction_id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [fk_receives_order]" & vbCrLf
    sql = sql & "            FOREIGN KEY ([order_id])" & vbCrLf
    sql = sql & "                REFERENCES [orders] ([id])," & vbCrLf
    sql = sql & "    CONSTRAINT" & vbCrLf
    sql = sql & "        [ck_receives_quantity]" & vbCrLf
    sql = sql & "            CHECK (" & vbCrLf
    sql = sql & "                [ok_quantity] >= 0" & vbCrLf
    sql = sql & "                AND [not_ok_quantity] >= 0" & vbCrLf
    sql = sql & "                AND [received_quantity] = [ok_quantity] + [not_ok_quantity]" & vbCrLf
    sql = sql & "            )" & vbCrLf
    sql = sql & ")" & vbCrLf
    EnsureTable "receives", sql

    ' Columns added later are created on an existing table.
    EnsureColumn "receives", "transaction_id", "LONG NOT NULL"
    EnsureColumn "receives", "order_id", "LONG NOT NULL"
    EnsureColumn "receives", "arrival_date", "DATETIME NOT NULL"
    EnsureColumn "receives", "verification_date", "DATETIME"
    EnsureColumn "receives", "received_quantity", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "receives", "ok_quantity", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "receives", "not_ok_quantity", "LONG NOT NULL DEFAULT 0"
    EnsureColumn "receives", "remarks", "LONGTEXT"
    EnsureColumn "receives", "system_remarks", "LONGTEXT"
    EnsureColumn "receives", "person_in_charge", "TEXT(255)"

    sql = ""
    sql = sql & "CREATE INDEX" & vbCrLf
    sql = sql & "    [idx_receives_arrival_date]" & vbCrLf
    sql = sql & "        ON [receives] ([arrival_date])" & vbCrLf
